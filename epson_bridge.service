[Unit]
Description=Epson TM-m30 to ESC/POS Bridge

[Service]
Type=simple
ExecStart=/path/to/epson_bridge/venv/bin/python /path/to/epson_bridge/epson_to_escpos_bridge.py --printer-ip <YOUR_PRINTER_IP>
WorkingDirectory=/path/to/epson_bridge
Restart=always
User=<your-username>

[Install]
WantedBy=multi-user.target
